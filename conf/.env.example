## LINKACE CONFIGURATION

## Basic app configuration
# The app key is generated later, please leave it like that
APP_KEY=__SECRET__
APP_ENV=production
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_FORCE_HTTPS=false
ASSET_URL=https://__DOMAIN__

## Configuration of the database connection
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD="__DB_PWD__"

## Mail configuration
MAIL_FROM_ADDRESS=__MAIL_USER__@__DOMAIN__
MAIL_FROM_NAME=LinkAce
# Set the driver used for sending email here, default is `log`
MAIL_MAILER=smtp
# Set the SMTP host and its port here
MAIL_HOST=__DOMAIN__
MAIL_PORT=587
# Set the username used to connect to the SMTP server here
MAIL_USERNAME=__APP__
# Set the password used to connect to the SMTP server here
MAIL_PASSWORD=__MAIL_PWD__
# If your SMTP server uses encrypted connections, enable it here by setting the variable to `tls`
MAIL_ENCRYPTION=tls
# If you are using self-signed certificates, add this setting to false to no verify SSL connections
MAIL_VERIFY_TLS=true
